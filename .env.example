# --- Supabase: λογαριασμοί και αποθήκευση ---
# Από Supabase Dashboard -> Settings -> API
# Το anon είναι δημόσιο κλειδί και προορίζεται για το frontend.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# --- Ενεργοποίηση των προτάσεων μέσω LLM ---
# Χωρίς αυτό, τρέχουν οι τοπικοί κανόνες, που δουλεύουν και offline.
VITE_ENABLE_LLM_INSIGHTS=false

# --- Google Gemini ---
# ΜΟΝΟ server-side. Δεν έχει πρόθεμα VITE_, οπότε δεν φτάνει ποτέ στον browser.
# Από aistudio.google.com -> Get API key. Δωρεάν, χωρίς κάρτα.
GEMINI_API_KEY=
